
<!DOCTYPE index.html>
<index.html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SportLive | Scores et F1</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#0b1020;color:#fff;font-family:Arial,sans-serif}
header{padding:28px 15px;text-align:center;background:linear-gradient(120deg,#087f5b,#12b886)}
header h1{margin:0;font-size:38px}
nav{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;background:#151c30;padding:12px}
nav button{background:transparent;color:#fff;border:1px solid #35415e;padding:12px;border-radius:9px;cursor:pointer}
nav button.active,nav button:hover{background:#12b886;color:#071b15}
main{max-width:900px;margin:auto;padding:20px}
.panel{display:none}
.panel.active{display:block}
.card{background:#171f35;border:1px solid #293450;border-radius:14px;padding:18px;margin:14px 0}
.muted{color:#b7c4df}
.score{font-size:25px;font-weight:bold}
.tag{color:#69db7c;font-size:13px}
button{cursor:pointer}
.refresh{padding:11px 14px;background:#12b886;color:#071b15;border:0;border-radius:8px;font-weight:bold}
li{margin:10px 0}
a{color:#69db7c}
footer{text-align:center;color:#b7c4df;padding:25px}
</style>
</head>
<body>
<header>
<h1>🏆 SportLive</h1>
<p>Les sports et les résultats au même endroit</p>
</header>

<nav>
<button class="active" data-tab="accueil">🏠 Accueil</button>
<button data-tab="football">⚽ Football</button>
<button data-tab="basket">🏀 Basket</button>
<button data-tab="tennis">🎾 Tennis</button>
<button data-tab="f1">🏎️ Formule 1</button>
</nav>

<main>
<section class="panel active" id="accueil">
<h2>Bienvenue sur SportLive</h2>
<p class="muted">Choisis un sport dans le menu pour consulter ses informations.</p>
<div class="card">
<h3>🔴 Football en direct</h3>
<p id="homeFootball">Chargement des matchs...</p>
</div>
<div class="card">
<h3>🏎️ Formule 1</h3>
<p id="homeF1">Chargement du calendrier...</p>
</div>
</section>

<section class="panel" id="football">
<h2>⚽ Football en direct</h2>
<p class="muted">Scores et matchs en cours.</p>
<button class="refresh" onclick="loadFootball()">Actualiser</button>
<div id="footballList"></div>
</section>

<section class="panel" id="basket">
<h2>🏀 Basket</h2>
<div class="card">
<p>Cette rubrique est prête à recevoir les scores de basket.</p>
<p class="muted">Une source de données basket sera nécessaire pour les résultats réels.</p>
</div>
</section>

<section class="panel" id="tennis">
<h2>🎾 Tennis</h2>
<div class="card">
<p>Cette rubrique est prête à recevoir les scores de tennis.</p>
<p class="muted">Une source de données tennis sera nécessaire pour les résultats réels.</p>
</div>
</section>

<section class="panel" id="f1">
<h2>🏎️ Formule 1 — Saison 2026</h2>
<p class="muted">Calendrier des Grands Prix et derniers résultats publiés.</p>
<button class="refresh" onclick="loadF1()">Actualiser la F1</button>
<div id="f1List"></div>
<h3>Derniers résultats de course</h3>
<div id="f1Results"></div>
</section>
</main>

<footer>SportLive © 2026</footer>

<script>
document.querySelectorAll("[data-tab]").forEach(button=>{
  button.addEventListener("click",()=>{
    document.querySelectorAll("[data-tab]").forEach(b=>b.classList.remove("active"));
    document.querySelectorAll(".panel").forEach(p=>p.classList.remove("active"));
    button.classList.add("active");
    document.getElementById(button.dataset.tab).classList.add("active");
  });
});

function addCard(container,title,detail){
  const card=document.createElement("article");
  card.className="card";
  const h=document.createElement("h3");
  h.textContent=title;
  const p=document.createElement("p");
  p.textContent=detail;
  card.append(h,p);
  container.append(card);
}

async function loadFootball(){
  const list=document.getElementById("footballList");
  const home=document.getElementById("homeFootball");
  list.replaceChildren();
  home.textContent="Chargement...";
  list.textContent="Chargement...";
  try{
    // Ajoute une clé API-FOOTBALL personnelle pour utiliser ce service.
    const key="COLLE_TA_CLE_API_ICI";
    if(key==="COLLE_TA_CLE_API_ICI"){
      list.textContent="Pour afficher les vrais scores, ajoute une clé API-FOOTBALL.";
      home.textContent="Clé API requise pour les scores en direct.";
      return;
    }
    const response=await fetch("https://v3.football.api-sports.io/fixtures?live=all",{
      headers:{"x-apisports-key":key}
    });
    if(!response.ok)throw new Error();
    const data=await response.json();
    list.replaceChildren();
    if(!data.response?.length){
      list.textContent="Aucun match en direct actuellement.";
      home.textContent="Aucun match en direct.";
      return;
    }
    home.textContent=data.response.length+" match(s) en direct.";
    data.response.forEach(match=>{
      addCard(list,
        match.teams.home.name+" "+match.goals.home+" - "+
        match.goals.away+" "+match.teams.away.name,
        match.league.name+" • "+match.fixture.status.long);
    });
  }catch{
    list.textContent="Impossible de charger les scores. Vérifie la connexion et la clé API.";
    home.textContent="Scores momentanément indisponibles.";
  }
}

async function loadF1(){
  const list=document.getElementById("f1List");
  const results=document.getElementById("f1Results");
  const home=document.getElementById("homeF1");
  list.textContent="Chargement du calendrier...";
  results.textContent="Chargement des résultats...";
  try{
    const [scheduleResponse,resultResponse]=await Promise.all([
      fetch("https://api.jolpi.ca/ergast/f1/2026/races/?limit=30"),
      fetch("https://api.jolpi.ca/ergast/f1/2026/last/results/?limit=30")
    ]);
    if(!scheduleResponse.ok||!resultResponse.ok)throw new Error();
    const schedule=await scheduleResponse.json();
    const resultData=await resultResponse.json();
    const races=schedule.MRData.RaceTable.Races||[];
    list.replaceChildren();
    if(!races.length){
      list.textContent="Calendrier indisponible.";
    }else{
      races.forEach(race=>{
        const date=new Date(race.date+"T12:00:00");
        addCard(list,"🏁 "+race.raceName,
          race.Circuit.circuitName+" • "+race.Circuit.Location.country+
          " • "+date.toLocaleDateString("fr-BE"));
      });
    }
    const resultRaces=resultData.MRData.RaceTable.Races||[];
    results.replaceChildren();
    if(!resultRaces.length){
      results.textContent="Aucun résultat publié pour le moment.";
    }else{
      resultRaces.forEach(race=>{
        const winners=(race.Results||[]).slice(0,3).map(r=>
          r.position+". "+r.Driver.givenName+" "+r.Driver.familyName+
          " ("+r.Constructor.name+")").join(" • ");
        addCard(results,race.raceName,winners||"Résultats non disponibles");
      });
    }
    home.textContent=races.length+" Grands Prix dans les données du calendrier.";
  }catch{
    list.textContent="Calendrier F1 indisponible. Réessaie plus tard.";
    results.textContent="Impossible de charger les résultats.";
    home.textContent="Calendrier F1 temporairement indisponible.";
  }
}

loadFootball();
loadF1();
setInterval(loadFootball,60000);
setInterval(loadF1,300000);
</script>
</body>
</index.html>
